@teste_HostAddress = http://localhost:5004

### Health check
GET {{teste_HostAddress}}/health
Accept: application/json

### Health check versionado (v1)
GET {{teste_HostAddress}}/api/v1/health
Accept: application/json

### Listar compradores (v1)
GET {{teste_HostAddress}}/api/v1/buyers
Accept: application/json

### Obter comprador por id (v1 — substitua o GUID)
GET {{teste_HostAddress}}/api/v1/buyers/00000000-0000-0000-0000-000000000000
Accept: application/json

### Listar pedidos do comprador (v1)
GET {{teste_HostAddress}}/api/v1/buyers/00000000-0000-0000-0000-000000000000/orders
Accept: application/json

### Listar pedidos do comprador com filtros (v1)
GET {{teste_HostAddress}}/api/v1/buyers/00000000-0000-0000-0000-000000000000/orders?status=ENVIADO&page=1&pageSize=20
Accept: application/json

### Criar comprador (v1)
POST {{teste_HostAddress}}/api/v1/buyers
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@example.com"
}

### Atualizar comprador (v1)
PUT {{teste_HostAddress}}/api/v1/buyers/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Maria Silva Santos",
  "email": "maria.santos@example.com"
}

### Excluir comprador (v1)
DELETE {{teste_HostAddress}}/api/v1/buyers/00000000-0000-0000-0000-000000000000

### Listar categorias (v1)
GET {{teste_HostAddress}}/api/v1/categories
Accept: application/json

### Obter categoria por id (v1)
GET {{teste_HostAddress}}/api/v1/categories/1
Accept: application/json

### Criar categoria (v1)
POST {{teste_HostAddress}}/api/v1/categories
Content-Type: application/json

{
  "name": "Outlet",
  "description": "Produtos em promoção"
}

### Atualizar categoria (v1)
PUT {{teste_HostAddress}}/api/v1/categories/1
Content-Type: application/json

{
  "name": "Eletrônicos",
  "description": "Departamento de eletrônicos",
  "active": true
}

### Excluir categoria (v1)
DELETE {{teste_HostAddress}}/api/v1/categories/16

### Listar produtos (v1)
GET {{teste_HostAddress}}/api/v1/products
Accept: application/json

### Obter produto por id (v1)
GET {{teste_HostAddress}}/api/v1/products/1
Accept: application/json

### Criar produto (v1)
POST {{teste_HostAddress}}/api/v1/products
Content-Type: application/json

{
  "name": "Notebook Pro 15",
  "description": "Notebook com 16GB RAM",
  "price": 4999.90,
  "brand": "TechBrand",
  "color": "Prata",
  "categoryIds": [1]
}

### Atualizar produto (v1)
PUT {{teste_HostAddress}}/api/v1/products/1
Content-Type: application/json

{
  "name": "Notebook Pro 15",
  "description": "Notebook com 32GB RAM",
  "price": 5499.90,
  "brand": "TechBrand",
  "color": "Preto",
  "active": true,
  "categoryIds": [1, 2]
}

### Excluir produto (v1)
DELETE {{teste_HostAddress}}/api/v1/products/1

### Listar pedidos (v1)
GET {{teste_HostAddress}}/api/v1/orders
Accept: application/json

### Listar pedidos com filtros e paginação (v1)
GET {{teste_HostAddress}}/api/v1/orders?status=INICIADO,PROCESSADO&createdFrom=2026-01-01&createdTo=2026-12-31&page=1&pageSize=10
Accept: application/json

### Obter pedido por id (v1 — substitua o GUID)
GET {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000
Accept: application/json

### Criar pedido (v1 — use buyerId e productId reais)
POST {{teste_HostAddress}}/api/v1/orders
Content-Type: application/json

{
  "buyerId": "00000000-0000-0000-0000-000000000000",
  "items": [
    { "productId": 1, "quantity": 2 }
  ]
}

### Processar pedido (v1 — INICIADO → PROCESSADO)
PUT {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "status": "PROCESSADO"
}

### Enviar pedido (v1 — PROCESSADO → ENVIADO)
PUT {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "status": "ENVIADO"
}

### Alterar comprador/itens (v1 — apenas INICIADO)
PATCH {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "buyerId": "00000000-0000-0000-0000-000000000000",
  "items": [
    { "productId": 1, "quantity": 1 }
  ]
}

### Cancelar pedido (v1)
POST {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000/cancel
Accept: application/json

### Excluir pedido (v1 — apenas INICIADO)
DELETE {{teste_HostAddress}}/api/v1/orders/00000000-0000-0000-0000-000000000000
