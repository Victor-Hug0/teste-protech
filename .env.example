# Copie para .env (cp .env.example .env). Usado por docker compose e dotnet run.
#
# Seq (logs estruturados): docker compose up -d seq
# Interface: http://localhost:5341  (requer API com dotnet run)
#
#
# Senha do SQL Server no Docker. A API monta ConnectionStrings__DefaultConnection
# automaticamente a partir desta variável (mesma senha do container).
# Se alterar após o primeiro start do SQL, recrie o volume:
#   docker compose down && docker volume rm teste_sqlserver_data && docker compose up -d sqlserver
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Opcionais (valores padrão abaixo se omitidos)
# DB_SERVER=127.0.0.1,1433
# DB_NAME=EcommerceDb

# Opcional: connection string completa (sobrescreve a montada acima)
# ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=EcommerceDb;User Id=sa;Password=YourStrong@Passw0rd;Encrypt=False;TrustServerCertificate=True;Connect Timeout=60;
